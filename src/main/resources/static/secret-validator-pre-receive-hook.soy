{namespace io.github.mschwehl.bb.secretvalidator.secretvalidatorprereceivehook}

/**
 * @param config
 * @param errors
 */
{template .formContents}
    {call aui.form.textField}
        {param id: 'mergeCommitMsgRegex' /}
        {param labelContent: 'Secret Path Glob Pattern' /}
        {param value:$config ? $config['mergeCommitMsgRegex'] : '*secrets*' /}
        {param descriptionText: 'Glob pattern to match secret file paths (case-insensitive). Must contain at least one *.' /}
        {param extraClasses: 'long-field' /}
        {param isRequired: 'true' /}
        {param errorTexts: $errors ? $errors['mergeCommitMsgRegex'] : null /}
    {/call}

    {call aui.form.textareaField}
        {param id: 'mergeCommitMsgSummaryText' /}
        {param labelContent: 'Summary notification' /}
        {param value:$config ? $config['mergeCommitMsgSummaryText'] : 'Unencrypted secret file detected' /}
        {param descriptionText: 'Summary message shown when an unencrypted secret file is rejected.' /}
        {param extraClasses: 'long-field' /}
        {param isRequired: 'true' /}
        {param errorTexts: $errors ? $errors['mergeCommitMsgSummaryText'] : null /}
    {/call}

    {call aui.form.textareaField}
        {param id: 'mergeCommitMsgDetailedText' /}
        {param labelContent: 'Detailed notification' /}
        {param value:$config ? $config['mergeCommitMsgDetailedText'] : 'The file must be encrypted with git-crypt before pushing.' /}
        {param descriptionText: 'Detailed message shown when an unencrypted secret file is rejected.' /}
        {param extraClasses: 'long-field' /}
        {param isRequired: 'true' /}
        {param errorTexts: $errors ? $errors['mergeCommitMsgDetailedText'] : null /}
    {/call}
{/template}
